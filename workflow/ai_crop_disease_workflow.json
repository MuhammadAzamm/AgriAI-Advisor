    {
      "parameters": {
        "jsCode": "// Get all 4 AI outputs directly\nconst diseaseRaw = $('Disease Identification').first().json.choices[0].message.content;\nconst causeRaw = $('Cause Analysis AI').first().json.choices[0].message.content;\nconst treatmentRaw = $('Treatment AI').first().json.choices[0].message.content;\nconst preventionRaw = $('Prevention AI').first().json.choices[0].message.content;\n\n// Parse each one\nconst disease = JSON.parse(diseaseRaw).disease || \"Unknown\";\nconst cause = JSON.parse(causeRaw).cause || \"Unknown\";\nconst treatment = JSON.parse(treatmentRaw).treatment || \"Unknown\";\nconst prevention = JSON.parse(preventionRaw).prevention || \"Unknown\";\n\nreturn [{\n  json: {\n    disease,\n    cause,\n    treatment,\n    prevention,\n    risk: \"Medium\"\n  }\n}];"
      },
