    {
      "parameters": {
        "jsCode": "// Get crop and problem from the first Code node\nconst crop = $('Code in JavaScript').first().json.crop || \"\";\nconst problem = $('Code in JavaScript').first().json.problem || \"\";\n\n// Get weather from HTTP Request output\nconst weatherData = $input.first().json;\nconst weather = weatherData?.weather?.[0]?.description || \"Not available\";\nconst temp = weatherData?.main?.temp \n  ? (weatherData.main.temp - 273.15).toFixed(1) + \"°C\" \n  : \"Not available\";\nconst humidity = weatherData?.main?.humidity \n  ? weatherData.main.humidity + \"%\" \n  : \"Not available\";\nconst city = weatherData?.name || \"Unknown\";\n\nreturn [\n  {\n    json: {\n      crop: crop,\n      problem: problem,\n      weather: weather,\n      temperature: temp,\n      humidity: humidity,\n      city: city,\n      keywords: [crop, problem, weather].filter(k => k !== \"\")\n    }\n  }\n];"
      },
